<Window x:Class="Game_team.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MXM Team Randomizer - قرعة الفرق الأسبوعية" Height="500" Width="680"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF3F4F6" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القسم الأيمن: إدخال الأسماء والإعدادات -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#FFD1D5DB" BlurRadius="8" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="قائمة اللاعبين" FontSize="16" FontWeight="Bold" Foreground="#FF1F2937" Margin="0,0,0,10"/>

                <!-- إدخال اسم اللاعب -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPlayerName" Height="32" VerticalContentAlignment="Center" Padding="6,0" FontSize="13" KeyDown="TxtPlayerName_KeyDown"/>
                    <Button Grid.Column="1" Content="إضافة" Width="60" Height="32" Margin="5,0,0,0" Click="BtnAddPlayer_Click"/>
                </Grid>

                <!-- قائمة الأسماء الحالية -->
                <ListBox x:Name="LbPlayers" Height="160" Margin="0,0,0,10" BorderBrush="#FFE5E7EB"/>

                <Button Content="حذف اللاعب المحدد" Background="#FFEF4444" Height="32" Margin="0,0,0,20" Click="BtnRemovePlayer_Click"/>

                <!-- خيارات التقسيم -->
                <Separator Margin="0,0,0,15"/>
                <TextBlock Text="إعدادات التقسيم" FontSize="16" FontWeight="Bold" Foreground="#FF1F2937" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="عدد الفرق المطلوبة:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtTeamsCount" Width="60" Height="30" Text="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14"/>
                </StackPanel>

                <!-- زر القرعة -->
                <Button Content="وزّع الفرق عشوائياً!" Background="#FF10B981" Height="40" Click="BtnRandomize_Click"/>
            </StackPanel>
        </Border>

        <!-- القسم الأيسر: عرض النتائج -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#FFD1D5DB" BlurRadius="8" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="نتائج القرعة والفرق" FontSize="16" FontWeight="Bold" Foreground="#FF1F2937" Margin="0,0,0,10"/>

                <!-- عرض الفرق باستخدام ItemsControl -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IcTeams">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TeamName}" FontWeight="Bold" FontSize="15" Foreground="#FF007ACC" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Players}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="#FF4B5563" Margin="15,2,0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>